#Template ActivityOverviewDailySummaryFull@1(props: { stepsIcon?: asset, caloriesIcon?: asset, distanceIcon?: asset })
data = {
    steps: $path("/dailySteps"),
    calories: $path("/dailyTotalCaloriesText"),
    distance: $path("/dailyDistanceText")
}

Column(
  "compact",
  {"_advancedComponent": "ActivityOverview", "width": "matchParent", "height": "matchParent", "padding": 12, "borderRadius": 20, "clip": true, "itemMargin": 0, "justifyContent": "start", "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
      "between",
      {"width": "matchParent", "height": 24, "itemMargin": 8, "justifyContent": "spaceBetween", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
            "今日步数",
            "compact-title",
            {"width": "matchParent", "height": 16, "fontSize": 12, "minFontSize": 12, "fontWeight": 600, "fontColor": "#FF000000", "maxLines": 1, "textOverflow": "ellipsis", "layoutWeight": 1, "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      IfPresent(
            props.stepsIcon,
            Image(
                    props.stepsIcon,
                    "icon",
                    {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0, "fillColor": "#FF000000"}
                  )
          )
    ),
  Column(
      "compact",
      {"width": "matchParent", "height": 78, "itemMargin": 8, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Row(
            "between",
            {"width": 90, "height": 32, "itemMargin": 2, "justifyContent": "start", "alignItems": "bottom", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
            Text(
                    data.steps,
                    "title",
                    {"width": 76, "height": 32, "fontSize": 30, "minFontSize": 24, "fontWeight": 800, "fontColor": "#FF000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  ),
            Text(
                    "步",
                    "subtitle",
                    {"width": 12, "height": 16, "fontSize": 12, "minFontSize": 10, "fontWeight": 600, "fontColor": "#FF000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
                  )
          ),
      Progress(
            {"value": data.steps, "total": 10000, "color": "#FF000000", "backgroundColor": "#33000000", "strokeWidth": 8, "height": 8, "width": "matchParent", "borderRadius": 20}
          )
    ),
  Column(
      "compact",
      {"width": 113, "height": 34, "itemMargin": 2, "justifyContent": "start", "alignItems": "start", "clip": true, "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
            `运动距离 ${data.distance}`,
            "body",
            {"width": 113, "height": 16, "fontSize": 12, "minFontSize": 10, "fontWeight": 700, "fontColor": "#FF000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      Text(
            `消耗热量 ${data.calories}`,
            "body",
            {"width": 113, "height": 16, "fontSize": 12, "minFontSize": 10, "fontWeight": 700, "fontColor": "#FF000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
    )
)
#End

#Template ActivityOverviewDailySummaryWideFull@1(props: { stepsIcon?: asset, caloriesIcon?: asset, distanceIcon?: asset })
