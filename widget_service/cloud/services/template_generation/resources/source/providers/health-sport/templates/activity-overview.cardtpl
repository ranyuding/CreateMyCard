#Template ActivityOverviewStepsFull@1(props: { stepsIcon?: asset })
data = {
    steps: $path("/dailySteps")
}

Column(
  "compact",
  {"_advancedComponent": "ActivityOverview", "width": "matchParent", "height": "matchParent", "itemMargin": 4, "justifyContent": "spaceBetween", "alignItems": "start", "constraintSize": {"minWidth": 0, "minHeight": 0}},
  Row(
      "between",
      {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "top", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      IfPresent(
            props.stepsIcon,
            Image(
                    props.stepsIcon,
                    "icon",
                    {"width": 20, "height": 20, "objectFit": "contain", "flexShrink": 0}
                  )
          ),
      Text(
            "今日活动",
            "subtitle",
            {"width": "matchParent", "fontSize": 12, "fontWeight": 500, "fontColor": "#FF000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
    ),
  Row(
      "between",
      {"width": "matchParent", "itemMargin": 4, "justifyContent": "start", "alignItems": "bottom", "constraintSize": {"minWidth": 0, "minHeight": 0}},
      Text(
            data.steps,
            "title",
            {"fontSize": 38, "fontWeight": 800, "fontColor": "#FF000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          ),
      Text(
            "步",
            "subtitle",
            {"fontSize": 12, "fontWeight": 500, "fontColor": "#FF000000", "maxLines": 1, "textOverflow": "ellipsis", "constraintSize": {"minWidth": 0, "minHeight": 0}}
          )
    )
)
#End

#Template ActivityOverviewStepsCompact@1(props: { stepsIcon?: asset })
data = {
